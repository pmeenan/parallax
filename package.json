{
  "name": "parallax",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "build": "node harness/scripts/build.mjs",
    "build:wasm": "node harness/scripts/build-wasm.mjs",
    "check": "pnpm build && pnpm lint && pnpm test:unit",
    "dev": "pnpm --filter @parallax/app dev",
    "deploy:production": "powershell -NoProfile -File deploy/Deploy-Production.ps1",
    "deploy:production:apply": "powershell -NoProfile -File deploy/Deploy-Production-Apply.ps1",
    "deploy:model-content": "powershell -NoProfile -File deploy/Deploy-Model-Content.ps1",
    "deploy:model-content:apply": "powershell -NoProfile -File deploy/Deploy-Model-Content-Apply.ps1",
    "harness:smoke": "pnpm build && node harness/dist/types/smoke-run.js",
    "harness:smoke:v8-cache": "pnpm build && node harness/dist/types/smoke-run.js --include-v8-code-cache",
    "harness:branded-parity": "pnpm build && node harness/dist/types/branded-parity-run.js",
    "harness:app-owned-llm": "pnpm build && node harness/dist/types/app-owned-llm-spike-bin.js",
    "harness:flythrough-d1": "pnpm build && node harness/dist/types/flythrough-d1-run.js",
    "harness:render-recovery": "pnpm build && node harness/dist/types/render-recovery-run.js",
    "harness:opfs-release-store-adapter": "pnpm build && node harness/dist/types/opfs-release-store-adapter-run.js",
    "harness:installer-trust-faults": "pnpm build && node harness/dist/types/installer-trust-faults-cli.js",
    "harness:installer-repair-production-replay": "pnpm build && node harness/dist/types/installer-repair-production-replay-run.js",
    "harness:asset-update:v8": "pnpm build && node harness/dist/types/asset-update-v8-run.js",
    "harness:model-source-verification": "pnpm build && node harness/dist/types/model-source-verification-run.js",
    "harness:pso-warmup:qualify": "pnpm build && node harness/dist/types/pso-warmup-qualification-run.js",
    "harness:shadow-strategies": "pnpm typecheck && node harness/dist/types/shadow-strategy-spike-run.js",
    "harness:uninstall-verification": "pnpm build && node harness/dist/types/uninstall-verification-run.js",
    "harness:scale-streaming": "pnpm build && node harness/dist/types/scale-streaming-run.js",
    "harness:baseline:promote": "pnpm build && node harness/dist/types/baseline-promote-bin.js",
    "lint": "biome check .",
    "serve": "node harness/scripts/serve.mjs",
    "start": "pnpm build && pnpm serve",
    "test": "pnpm build && pnpm test:unit",
    "test:unit": "vitest run",
    "typecheck": "tsc -b",
    "verify:repeatable": "node harness/scripts/verify-engine-repeatability.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "24.13.3",
    "binaryen": "131.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
